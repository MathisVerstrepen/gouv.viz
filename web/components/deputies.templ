package components

import (
	"net/url"
	"strconv"
	"strings"
)

type DeputiesQuery struct {
	Search      string
	Sort        string
	Page        int
	PerPage     int
	Legislature int
	Group       string
}

type DeputyListItem struct {
	UID           string
	DisplayName   string
	Alpha         string
	Profession    string
	DateNaissance string
	Legislature   int
	GroupUID      string
	Group         string
	GroupAbrege   string
	GroupAbrev    string
	TotalVotes    int
	Pour          int
	Contre        int
	Abstentions   int
	NonVotants    int
}

type DeputySortOption struct {
	Value string
	Label string
}

type DeputyFilterOption struct {
	Value string
	Label string
}

type DeputyFilterOptions struct {
	Legislatures []DeputyFilterOption
	Groups       []DeputyFilterOption
}

type DeputiesPage struct {
	Query         DeputiesQuery
	DefaultSort   string
	SortOptions   []DeputySortOption
	FilterOptions DeputyFilterOptions
	Deputies      []DeputyListItem
	TotalResults  int
	TotalPages    int
	StartItem     int
	EndItem       int
}

templ Deputies(page DeputiesPage) {
	<div class="page-shell">
		@SiteHeader("deputes")

		<main id="contenu" class="page-main">
			<section class="section page-heading">
				<div class="fr-container">
					<p class="eyebrow">Exploration</p>
					<h1>Tous les députés</h1>
					<p class="lead">
						Recherchez un député, filtrez par législature ou groupe politique, puis consultez sa fiche détaillée et ses votes nominatifs.
					</p>
				</div>
			</section>

			<section class="section section--muted">
				<div class="fr-container">
					@DeputiesExplorer(page)
				</div>
			</section>
		</main>

		@SiteFooter()
	</div>
}

templ DeputiesExplorer(page DeputiesPage) {
	<div id="deputies-explorer">
		<form class="scrutin-toolbar" method="get" action="/deputes" role="search" hx-get="/deputes" hx-target="#deputies-explorer" hx-swap="outerHTML" hx-push-url="true">
			<label class="field field--search" for="q">
				<span>Recherche</span>
				<input id="q" name="q" type="search" value={ page.Query.Search } placeholder="Ex. nom, profession, groupe"/>
			</label>
			<div class="scrutin-filters deputies-filters" aria-label="Filtres des députés">
				<label class="field" for="legislature">
					<span>Législature</span>
					<select id="legislature" name="legislature">
						<option value="">Toutes</option>
						for _, option := range page.FilterOptions.Legislatures {
							<option value={ option.Value } selected?={ option.Value == strconv.Itoa(page.Query.Legislature) }>{ option.Label }</option>
						}
					</select>
				</label>
				<label class="field" for="group">
					<span>Groupe actuel</span>
					<select id="group" name="group">
						<option value="">Tous</option>
						for _, option := range page.FilterOptions.Groups {
							<option value={ option.Value } selected?={ option.Value == page.Query.Group }>{ option.Label }</option>
						}
					</select>
				</label>
			</div>
			<input type="hidden" name="sort" value={ page.Query.Sort }/>
			<div class="scrutin-toolbar__actions">
				<button class="button" type="submit">Appliquer</button>
				if hasDeputyFilters(page.Query) {
					<a class="button button--secondary" href={ clearDeputySearchURL(page.Query, page.DefaultSort) } hx-get={ clearDeputySearchURL(page.Query, page.DefaultSort) } hx-target="#deputies-explorer" hx-swap="outerHTML" hx-push-url="true">Effacer</a>
				}
			</div>
		</form>

		<div class="sort-panel" aria-label="Options de tri">
			<span>Trier par</span>
			<div class="sort-panel__links">
				for _, option := range page.SortOptions {
					<a class={ sortLinkClass(option.Value == page.Query.Sort) } href={ deputyListURL(page.Query, page.DefaultSort, 1, option.Value) } hx-get={ deputyListURL(page.Query, page.DefaultSort, 1, option.Value) } hx-target="#deputies-explorer" hx-swap="outerHTML" hx-push-url="true">{ option.Label }</a>
				}
			</div>
		</div>

		<div class="list-status" aria-live="polite">
			<p>{ deputyResultSummary(page) }</p>
			<p>Tri actuel : { currentDeputySortLabel(page) }.</p>
		</div>

		if len(page.Deputies) == 0 {
			<p class="empty-state">Aucun député ne correspond aux critères. Modifiez la recherche ou relancez <code>make preprocess</code> si la base est vide.</p>
		} else {
			<div class="deputy-list" aria-label="Liste paginée des députés">
				for _, deputy := range page.Deputies {
					@DeputyCard(deputy)
				}
			</div>

			@DeputiesPagination(page)
		}
	</div>
}

templ DeputyCard(deputy DeputyListItem) {
	<article class="deputy-card">
		<div class="deputy-card__media">
			if deputyHasNoRecordedVotes(deputy) {
				<span class="deputy-card__photo deputy-card__photo--placeholder" role="img" aria-label="Portrait non affiché faute de votes enregistrés">{ deputyListInitials(deputy) }</span>
			} else if deputyListPhotoURL(deputy) != "" {
				<img class="deputy-card__photo" src={ deputyListPhotoURL(deputy) } alt={ "Portrait officiel de " + deputy.DisplayName } loading="lazy" width="96" height="96"/>
			}
			if deputyListGroupLogoURL(deputy) != "" {
				<a class="deputy-card__group-link" href={ PoliticalGroupDetailURL(deputy.GroupUID) } aria-label={ "Voir le groupe " + deputyGroupLabel(deputyListGroup(deputy)) }>
					<img class="deputy-card__group-logo" src={ deputyListGroupLogoURL(deputy) } alt={ "Logo du groupe " + deputyGroupLabel(deputyListGroup(deputy)) } loading="lazy" width="48" height="48"/>
				</a>
			}
		</div>
		<div class="deputy-card__body">
			<p class="eyebrow">Député</p>
			<h2><a class="scrutin-card__title-link" href={ DeputyDetailURL(deputy.UID) }>{ deputy.DisplayName }</a></h2>
			<div class="deputy-card__meta">
				if deputy.Alpha != "" {
					<span>{ deputy.Alpha }</span>
				}
				if deputy.Legislature > 0 {
					<span>{ strconv.Itoa(deputy.Legislature) }e législature</span>
				}
				if deputy.Group != "" {
					<span>{ deputy.Group }</span>
				}
			</div>
			if deputy.Profession != "" {
				<p>{ deputy.Profession }</p>
			}
		</div>
		<dl class="deputy-card__stats" aria-label="Synthèse des votes">
			<div>
				<dt>Votes</dt>
				<dd>{ strconv.Itoa(deputy.TotalVotes) }</dd>
			</div>
			<div class="vote-count--pour">
				<dt>Pour</dt>
				<dd>{ strconv.Itoa(deputy.Pour) }</dd>
			</div>
			<div class="vote-count--contre">
				<dt>Contre</dt>
				<dd>{ strconv.Itoa(deputy.Contre) }</dd>
			</div>
		</dl>
	</article>
}

templ DeputiesPagination(page DeputiesPage) {
	<nav class="pagination" aria-label="Pagination des députés">
		if page.Query.Page > 1 {
			<a class="pagination__link" href={ deputyListURL(page.Query, page.DefaultSort, page.Query.Page - 1, page.Query.Sort) } hx-get={ deputyListURL(page.Query, page.DefaultSort, page.Query.Page - 1, page.Query.Sort) } hx-target="#deputies-explorer" hx-swap="outerHTML" hx-push-url="true">Précédent</a>
		} else {
			<span class="pagination__link pagination__link--disabled">Précédent</span>
		}

		<div class="pagination__pages">
			for _, pageNumber := range paginationPages(page.Query.Page, page.TotalPages) {
				if pageNumber == 0 {
					<span class="pagination__ellipsis" aria-hidden="true">...</span>
				} else if pageNumber == page.Query.Page {
					<span class="pagination__link pagination__link--current" aria-current="page">{ strconv.Itoa(pageNumber) }</span>
				} else {
					<a class="pagination__link" href={ deputyListURL(page.Query, page.DefaultSort, pageNumber, page.Query.Sort) } hx-get={ deputyListURL(page.Query, page.DefaultSort, pageNumber, page.Query.Sort) } hx-target="#deputies-explorer" hx-swap="outerHTML" hx-push-url="true">{ strconv.Itoa(pageNumber) }</a>
				}
			}
		</div>

		if page.Query.Page < page.TotalPages {
			<a class="pagination__link" href={ deputyListURL(page.Query, page.DefaultSort, page.Query.Page + 1, page.Query.Sort) } hx-get={ deputyListURL(page.Query, page.DefaultSort, page.Query.Page + 1, page.Query.Sort) } hx-target="#deputies-explorer" hx-swap="outerHTML" hx-push-url="true">Suivant</a>
		} else {
			<span class="pagination__link pagination__link--disabled">Suivant</span>
		}
	</nav>
}

func deputyListURL(query DeputiesQuery, defaultSort string, page int, sort string) string {
	values := url.Values{}
	if strings.TrimSpace(query.Search) != "" {
		values.Set("q", query.Search)
	}
	if query.Legislature > 0 {
		values.Set("legislature", strconv.Itoa(query.Legislature))
	}
	if query.Group != "" {
		values.Set("group", query.Group)
	}
	if sort != "" && sort != defaultSort {
		values.Set("sort", sort)
	}
	if page > 1 {
		values.Set("page", strconv.Itoa(page))
	}
	encoded := values.Encode()
	if encoded == "" {
		return "/deputes"
	}
	return "/deputes?" + encoded
}

func clearDeputySearchURL(query DeputiesQuery, defaultSort string) string {
	query.Search = ""
	query.Legislature = 0
	query.Group = ""
	return deputyListURL(query, defaultSort, 1, query.Sort)
}

func hasDeputyFilters(query DeputiesQuery) bool {
	return strings.TrimSpace(query.Search) != "" || query.Legislature > 0 || query.Group != ""
}

func deputyResultSummary(page DeputiesPage) string {
	if page.TotalResults == 0 {
		return "0 député trouvé."
	}
	return strconv.Itoa(page.StartItem) + "-" + strconv.Itoa(page.EndItem) + " sur " + strconv.Itoa(page.TotalResults) + " députés."
}

func currentDeputySortLabel(page DeputiesPage) string {
	for _, option := range page.SortOptions {
		if option.Value == page.Query.Sort {
			return option.Label
		}
	}
	return page.Query.Sort
}

func deputyListGroup(deputy DeputyListItem) DeputyMandatOrgane {
	return DeputyMandatOrgane{
		UID:           deputy.GroupUID,
		CodeType:      "GP",
		Libelle:       firstNonEmpty(deputy.Group, deputy.GroupAbrege, deputy.GroupAbrev, deputy.GroupUID),
		LibelleAbrege: deputy.GroupAbrege,
		LibelleAbrev:  deputy.GroupAbrev,
	}
}

func deputyListGroupLogoURL(deputy DeputyListItem) string {
	return groupLogoURL(deputyListGroup(deputy))
}

func deputyListPhotoURL(deputy DeputyListItem) string {
	id := deputyPhotoID(deputy.UID)
	if id == "" {
		return ""
	}
	legislature := deputy.Legislature
	if legislature < 1 {
		legislature = 17
	}
	return "https://www.assemblee-nationale.fr/dyn/static/tribun/" + strconv.Itoa(legislature) + "/photos/carre/" + id + ".jpg"
}

func deputyHasNoRecordedVotes(deputy DeputyListItem) bool {
	return deputy.TotalVotes == 0 && deputy.Pour == 0 && deputy.Contre == 0
}

func deputyListInitials(deputy DeputyListItem) string {
	label := firstNonEmpty(deputy.DisplayName, deputy.Alpha, deputy.UID)
	parts := strings.Fields(label)
	if len(parts) == 0 {
		return "?"
	}
	if len(parts) == 1 {
		return strings.ToUpper(string([]rune(parts[0])[0]))
	}
	first := []rune(parts[0])
	last := []rune(parts[len(parts)-1])
	return strings.ToUpper(string(first[0]) + string(last[0]))
}
