package components

import "strconv"

type ErrorPageData struct {
	StatusCode int
	Title      string
	Message    string
}

templ ErrorPage(page ErrorPageData) {
	<div class="page-shell">
		@SiteHeader("")

		<main id="contenu" class="page-main">
			<section class="section section--muted">
				<div class="fr-container">
					<div class="empty-state">
						<p class="eyebrow">Erreur { strconv.Itoa(page.StatusCode) }</p>
						<h1>{ page.Title }</h1>
						<p>{ page.Message }</p>
						<div class="hero__actions" aria-label="Actions disponibles">
							<a class="button" href="/">Retour à l'accueil</a>
							<a class="button button--secondary" href="/scrutins">Explorer les scrutins</a>
						</div>
					</div>
				</div>
			</section>
		</main>

		@SiteFooter()
	</div>
}
