package components

import (
	"strconv"
	"time"
)

type HomePage struct {
	TotalScrutins    int
	TotalDeputies    int
	TotalGroups      int
	FirstScrutinDate string
	LastScrutinDate  string
	GeneratedAt      string
	OrganesCount     int
	ActeursCount     int
	MandatsCount     int
	VotesCount       int
	Scrutins         []ScrutinListItem
}

type ScrutinListItem struct {
	UID            string
	Numero         int
	Date           string
	Titre          string
	SortCode       string
	TypeVote       string
	Organe         string
	Pour           int
	Contre         int
	Abstentions    int
	NombreVotants  int
}

func formatDate(value string) string {
	date, err := time.Parse("2006-01-02", value)
	if err != nil {
		return value
	}
	return date.Format("02/01/2006")
}

func formatDateTime(value string) string {
	date, err := time.Parse(time.RFC3339, value)
	if err != nil {
		return value
	}
	return date.UTC().Format("02/01/2006 à 15:04 UTC")
}

func hasDatasetMeta(page HomePage) bool {
	return page.GeneratedAt != "" || page.OrganesCount > 0 || page.ActeursCount > 0 || page.MandatsCount > 0 || page.VotesCount > 0
}

templ Home(page HomePage) {
	<div class="page-shell">
		@SiteHeader("home")

		<main id="contenu" class="page-main">
			<section class="hero section">
				<div class="fr-container hero__grid">
					<div class="hero__content">
						<p class="eyebrow">Données publiques</p>
						<h1>Explorez les votes, les députés et les groupes politiques</h1>
						<p class="lead">
							Parcourez les scrutins publics de l'Assemblée nationale, retrouvez les fiches des députés et suivez l'activité des groupes politiques à partir des données ouvertes.
						</p>
						<div class="hero__actions" aria-label="Actions principales">
							<a class="button" href="/scrutins">Explorer tous les scrutins</a>
							<a class="button button--secondary" href="/deputes">Voir les députés</a>
							<a class="button button--secondary" href="/groupes">Voir les groupes</a>
						</div>
					</div>

					<aside class="hero__panel" aria-label="État des données">
						<h2>Données indexées</h2>
						<p>
							Période couverte : { formatDate(page.FirstScrutinDate) } - { formatDate(page.LastScrutinDate) }.
						</p>
						<div class="metric-list" aria-label="Volumes disponibles">
							<div class="metric-card">
								<strong>{ strconv.Itoa(page.TotalScrutins) }</strong>
								<span>Scrutins</span>
							</div>
							<div class="metric-card">
								<strong>{ strconv.Itoa(page.TotalDeputies) }</strong>
								<span>Députés</span>
							</div>
							<div class="metric-card">
								<strong>{ strconv.Itoa(page.TotalGroups) }</strong>
								<span>Groupes</span>
							</div>
						</div>
						if hasDatasetMeta(page) {
							<div class="dataset-meta" aria-label="Fraîcheur des données">
								if page.GeneratedAt != "" {
									<p>Données générées le { formatDateTime(page.GeneratedAt) }.</p>
								}
								<ul>
									if page.OrganesCount > 0 {
										<li>{ strconv.Itoa(page.OrganesCount) } organes importés</li>
									}
									if page.ActeursCount > 0 {
										<li>{ strconv.Itoa(page.ActeursCount) } acteurs importés</li>
									}
									if page.MandatsCount > 0 {
										<li>{ strconv.Itoa(page.MandatsCount) } mandats importés</li>
									}
									if page.VotesCount > 0 {
										<li>{ strconv.Itoa(page.VotesCount) } votes individuels importés</li>
									}
								</ul>
							</div>
						}
					</aside>
				</div>
			</section>

			<section id="scrutins" class="section section--muted">
				<div class="fr-container">
					<div class="section-heading">
						<p class="eyebrow">Scrutins récents</p>
						<h2>Les 50 derniers votes publics</h2>
						<p>
							Liste triée par date de scrutin décroissante, avec résultat et décompte principal. <a href="/scrutins">Ouvrir l'exploration complète</a>.
						</p>
					</div>

					if len(page.Scrutins) == 0 {
						<p class="empty-state">Aucun scrutin trouvé. Lancez <code>make preprocess</code> pour générer la base SQLite.</p>
					} else {
						<div class="scrutin-list" aria-label="Liste des scrutins publics">
							for _, scrutin := range page.Scrutins {
								@ScrutinCard(scrutin)
							}
						</div>
					}
				</div>
			</section>
		</main>

		@SiteFooter()
	</div>
}
