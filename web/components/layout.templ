package components

import "os"

func environment() string {
	return os.Getenv("ENV")
}

templ layout(content templ.Component, title string, description string) {
	<!DOCTYPE html>
	<html lang="fr" data-fr-scheme="system">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content={ description }/>
			<meta name="htmx-config" content='{"includeIndicatorStyles": false}'/>
			<meta name="msapplication-TileColor" content="#ffffff"/>
			<meta name="msapplication-config" content="/assets/favicon/browserconfig.xml"/>
			<meta name="theme-color" content="#ffffff"/>
			<title>{ title }</title>
			<link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-icon-180x180.png"/>
			<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png"/>
			<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png"/>
			<link rel="manifest" href="/assets/favicon/manifest.json"/>
			<link rel="shortcut icon" href="/assets/favicon/favicon.ico"/>
			<script src="/assets/js/theme.js"></script>
			<link rel="stylesheet" href="/assets/css/main.css"/>
			<script src="/assets/js/htmx.min.js" defer></script>
			if environment() != "prod" {
				<script src="/assets/js/hot-reload.js" defer></script>
			}
		</head>
		<body>
			<a class="skip-link" href="#contenu">Aller au contenu</a>
			@content
		</body>
	</html>
}

templ Root(content templ.Component, title string, description string) {
	@layout(content, title, description)
}

templ SiteHeader(active string) {
	<header class="site-header">
		<div class="fr-container site-header__inner">
			<a class="brand-logo" href="/" aria-label="Accueil - Gouv.viz">
				<img alt="" width="48" height="48" loading="lazy"/>
			</a>
			<div class="service-title" aria-label="Service">
				<p class="service-title__name">Gouv.viz</p>
				<p class="service-title__tagline">Visualisation non officielle des données de l'Assemblée nationale</p>
			</div>
			<nav class="site-nav" aria-label="Navigation principale">
				<a href="/" class={ navLinkClass(active == "home") }>Accueil</a>
				<a href="/scrutins" class={ navLinkClass(active == "scrutins") }>Scrutins</a>
				<a href="/deputes" class={ navLinkClass(active == "deputes") }>Députés</a>
				<a href="/groupes" class={ navLinkClass(active == "groupes") }>Groupes</a>
			</nav>
			<button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false">
				<span class="theme-toggle__icon" aria-hidden="true"></span>
				<span data-theme-toggle-label>Mode clair</span>
			</button>
		</div>
	</header>
}

templ SiteFooter() {
	<footer class="site-footer">
		<div class="fr-container site-footer__inner">
			<p>gouv.viz</p>
			<p>Réalisé par 
                <a href="https://github.com/MathisVerstrepen" target="_blank" rel="noopener noreferrer">Mathis Verstrepen</a>
            </p>
		</div>
	</footer>
}

func navLinkClass(active bool) string {
	if active {
		return "site-nav__link site-nav__link--active"
	}
	return "site-nav__link"
}
