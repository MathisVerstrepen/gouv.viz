package components

import "os"

func environment() string {
	return os.Getenv("ENV")
}

templ layout(content templ.Component, title string) {
	<!DOCTYPE html>
	<html lang="fr" data-fr-scheme="system">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content="Visualisation des scrutins publics de l'Assemblee nationale"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/assets/css/main.css"/>
			<script src="/assets/js/htmx.min.js" defer></script>
			if environment() != "prod" {
				<script>
					const socket = new WebSocket(`ws://${window.location.hostname}:9456/ws`);
					window.addEventListener("beforeunload", () => socket.close());
					socket.addEventListener("close", (event) => {
						if (event.code === 1000) return;
						const interval = setInterval(() => {
							fetch("/ping").then((response) => {
								if (!response.ok) return;
								clearInterval(interval);
								setTimeout(() => window.location.reload(), 100);
							});
						}, 200);
					});
				</script>
			}
		</head>
		<body>
			<a class="skip-link" href="#contenu">Aller au contenu</a>
			@content
		</body>
	</html>
}

templ Root(content templ.Component, title string) {
	@layout(content, title)
}

templ SiteHeader(active string) {
	<header class="site-header">
		<div class="fr-container site-header__inner">
			<a class="brand-block" href="/" aria-label="Accueil - gouv.viz">
				<span>Republique</span>
				<span>Francaise</span>
			</a>
			<div class="service-title" aria-label="Service">
				<p class="service-title__name">gouv.viz</p>
				<p class="service-title__tagline">Scrutins publics de l'Assemblee nationale</p>
			</div>
			<nav class="site-nav" aria-label="Navigation principale">
				<a href="/" class={ navLinkClass(active == "home") }>Accueil</a>
				<a href="/scrutins" class={ navLinkClass(active == "scrutins") }>Scrutins</a>
			</nav>
		</div>
	</header>
}

templ SiteFooter() {
	<footer class="site-footer">
		<div class="fr-container site-footer__inner">
			<p>gouv.viz</p>
			<p>Visualisation statique des scrutins publics.</p>
		</div>
	</footer>
}

func navLinkClass(active bool) string {
	if active {
		return "site-nav__link site-nav__link--active"
	}
	return "site-nav__link"
}
