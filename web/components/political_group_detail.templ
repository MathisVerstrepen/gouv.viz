package components

import (
	"net/url"
	"strconv"
	"strings"
)

const defaultPoliticalGroupVotesSort = "date_desc"
const visiblePoliticalGroupDeputiesCount = 9

type PoliticalGroupDetailPage struct {
	Group             PoliticalGroupData
	Query             PoliticalGroupDetailQuery
	Stats             []PoliticalGroupVoteStat
	Deputies          []PoliticalGroupDeputy
	Votes             []PoliticalGroupVote
	VotesTotalResults int
	VotesTotalPages   int
	VotesStartItem    int
	VotesEndItem      int
}

type PoliticalGroupDetailQuery struct {
	VotesPage     int
	VotesPerPage  int
	VotesSearch   string
	VotesSort     string
	VotesPosition string
}

type PoliticalGroupData struct {
	UID               string
	CodeType          string
	Libelle           string
	LibelleAbrege     string
	LibelleAbrev      string
	LibelleEdition    string
	Legislature       int
	Chambre           string
	Regime            string
	PositionPolitique string
	CouleurAssociee   string
	Preseance         int
	DateDebut         string
	DateFin           string
	SourceFile        string
}

type PoliticalGroupVoteStat struct {
	Legislature   int
	TotalScrutins int
	Pour          int
	Contre        int
	Abstentions   int
	NonVotants    int
}

type PoliticalGroupDeputy struct {
	UID         string
	DisplayName string
	Alpha       string
	Legislature int
	MandatUID   string
	DateDebut   string
	DateFin     string
	Qualite     string
}

type PoliticalGroupVote struct {
	ScrutinUID            string
	Numero                int
	Legislature           int
	Date                  string
	Titre                 string
	SortCode              string
	SortLibelle           string
	TypeVote              string
	PositionMajoritaire   string
	NombreMembres         int
	Pour                  int
	Contre                int
	Abstentions           int
	NonVotants            int
	NonVotantsVolontaires int
}

templ PoliticalGroupDetail(page PoliticalGroupDetailPage) {
	<div class="page-shell">
		@SiteHeader("deputes")

		<main id="contenu" class="page-main">
			<section class="section page-heading detail-heading">
				<div class="fr-container">
					<nav class="breadcrumb" aria-label="Fil d'Ariane">
						<a href="/">Accueil</a>
						<span aria-hidden="true">/</span>
						<a href="/deputes">Députés</a>
						<span aria-hidden="true">/</span>
						<span>{ PoliticalGroupLabel(page.Group) }</span>
					</nav>
					<div class="detail-heading__title-row">
						<div class="deputy-heading__identity">
							if politicalGroupLogoURL(page.Group) != "" {
								<img class="political-group-heading__logo" src={ politicalGroupLogoURL(page.Group) } alt={ "Logo du groupe " + PoliticalGroupLabel(page.Group) } loading="lazy" width="112" height="112"/>
							}
							<div>
								<p class="eyebrow">Groupe politique</p>
								<h1>{ PoliticalGroupLabel(page.Group) }</h1>
							</div>
						</div>
					</div>
					<div class="detail-heading__meta">
						if page.Group.LibelleAbrev != "" {
							<span>{ page.Group.LibelleAbrev }</span>
						}
						if page.Group.Legislature > 0 {
							<span>{ strconv.Itoa(page.Group.Legislature) }e législature</span>
						}
						<span>{ strconv.Itoa(politicalGroupTotalScrutins(page)) } scrutins recensés</span>
						<span>{ strconv.Itoa(len(page.Deputies)) } députés rattachés</span>
					</div>
				</div>
			</section>

			<section class="section section--muted">
				<div class="fr-container detail-layout">
					<div class="detail-main">
						<section class="detail-card" aria-labelledby="groupe-statistiques">
							<h2 id="groupe-statistiques">Synthèse des votes du groupe</h2>
							if len(page.Stats) == 0 {
								<p class="empty-state">Aucune statistique agrégée disponible pour ce groupe.</p>
							} else {
								<dl class="detail-metrics">
									<div>
										<dt>Scrutins</dt>
										<dd>{ strconv.Itoa(politicalGroupTotalScrutins(page)) }</dd>
									</div>
									<div class="detail-metric--pour">
										<dt>Pour</dt>
										<dd>{ strconv.Itoa(politicalGroupTotalPour(page.Stats)) }</dd>
									</div>
									<div class="detail-metric--contre">
										<dt>Contre</dt>
										<dd>{ strconv.Itoa(politicalGroupTotalContre(page.Stats)) }</dd>
									</div>
								</dl>
								@PoliticalGroupStatsTable(page.Stats)
							}
						</section>

						<section class="detail-card" aria-labelledby="groupe-deputes">
							<h2 id="groupe-deputes">Députés rattachés</h2>
							if len(page.Deputies) == 0 {
								<p class="empty-state">Aucun député rattaché à ce groupe dans les mandats importés.</p>
							} else {
								@PoliticalGroupDeputyGrid(visiblePoliticalGroupDeputies(page.Deputies))
								if len(hiddenPoliticalGroupDeputies(page.Deputies)) > 0 {
									<details class="political-group-member-disclosure">
										<summary>{ politicalGroupRemainingDeputiesLabel(len(hiddenPoliticalGroupDeputies(page.Deputies))) }</summary>
										@PoliticalGroupDeputyGrid(hiddenPoliticalGroupDeputies(page.Deputies))
									</details>
								}
							}
						</section>

						<section class="detail-card" aria-labelledby="groupe-votes">
							<h2 id="groupe-votes">Historique des votes</h2>
							@PoliticalGroupVotesPanel(page)
						</section>
					</div>

					<aside class="detail-aside" aria-labelledby="groupe-informations">
						<section class="detail-card">
							<h2 id="groupe-informations">Informations</h2>
							<dl class="detail-list">
								@DetailRow("UID", page.Group.UID)
								@DetailRow("Libellé", page.Group.Libelle)
								@DetailRow("Libellé abrégé", page.Group.LibelleAbrege)
								@DetailRow("Abréviation", page.Group.LibelleAbrev)
								@DetailRow("Position politique", page.Group.PositionPolitique)
								@DetailRow("Date de début", formatDate(page.Group.DateDebut))
								@DetailRow("Date de fin", formatDate(page.Group.DateFin))
							</dl>
						</section>
					</aside>
				</div>
			</section>
		</main>

		@SiteFooter()
	</div>
}

templ PoliticalGroupDeputyGrid(deputies []PoliticalGroupDeputy) {
	<div class="political-group-member-grid">
		for _, deputy := range deputies {
			@PoliticalGroupDeputyCard(deputy)
		}
	</div>
}

templ PoliticalGroupDeputyCard(deputy PoliticalGroupDeputy) {
	<article class="political-group-member-card">
		<a class="political-group-member-card__photo-link" href={ DeputyDetailURL(deputy.UID) } aria-label={ "Voir la fiche de " + deputy.DisplayName }>
			if politicalGroupDeputyPhotoURL(deputy) != "" {
				<img class="political-group-member-card__photo" src={ politicalGroupDeputyPhotoURL(deputy) } alt={ "Portrait officiel de " + deputy.DisplayName } loading="lazy" width="128" height="128"/>
			} else {
				<span class="political-group-member-card__photo political-group-member-card__photo--placeholder" aria-hidden="true">{ politicalGroupDeputyInitials(deputy) }</span>
			}
		</a>
		<div class="political-group-member-card__body">
			<h3><a href={ DeputyDetailURL(deputy.UID) }>{ deputy.DisplayName }</a></h3>
			<p>{ politicalGroupDeputyMeta(deputy) }</p>
		</div>
	</article>
}

templ PoliticalGroupVotesPanel(page PoliticalGroupDetailPage) {
	<div id="groupe-votes-panel">
		@PoliticalGroupVotesToolbar(page)
		if len(page.Votes) == 0 {
			if hasPoliticalGroupVoteControls(page.Query) {
				<p class="empty-state">Aucun vote de groupe ne correspond aux critères.</p>
			} else {
				<p class="empty-state">Aucun vote de groupe disponible.</p>
			}
		} else {
			<div class="list-status" aria-live="polite">
				<p>{ politicalGroupVotesSummary(page) }</p>
				<p>{ politicalGroupVotesSortSummary(page.Query) }</p>
			</div>
			@PoliticalGroupVotesTable(page.Votes)
			@PoliticalGroupVotesPagination(page)
		}
	</div>
}

templ PoliticalGroupVotesToolbar(page PoliticalGroupDetailPage) {
	<form class="scrutin-toolbar political-group-votes-toolbar" method="get" action={ PoliticalGroupDetailURL(page.Group.UID) } hx-get={ PoliticalGroupDetailURL(page.Group.UID) } hx-target="#groupe-votes-panel" hx-swap="outerHTML" hx-push-url="true">
		<label class="field field--search" for="votes_q">
			<span>Recherche</span>
			<input id="votes_q" name="votes_q" type="search" value={ page.Query.VotesSearch } placeholder="Ex. budget, commission, rejet"/>
		</label>
		<div class="scrutin-filters" aria-label="Filtres des votes du groupe">
			<label class="field" for="votes_position">
				<span>Position du groupe</span>
				<select id="votes_position" name="votes_position">
					<option value="">Toutes</option>
					for _, option := range politicalGroupVotePositionOptions() {
						<option value={ option.Value } selected?={ option.Value == page.Query.VotesPosition }>{ option.Label }</option>
					}
				</select>
			</label>
			<label class="field" for="votes_sort">
				<span>Tri</span>
				<select id="votes_sort" name="votes_sort">
					for _, option := range politicalGroupVoteSortOptions() {
						<option value={ option.Value } selected?={ option.Value == page.Query.VotesSort }>{ option.Label }</option>
					}
				</select>
			</label>
		</div>
		<div class="scrutin-toolbar__actions">
			<button class="button" type="submit">Appliquer</button>
			if hasPoliticalGroupVoteControls(page.Query) {
				<a class="button button--secondary" href={ clearPoliticalGroupVotesURL(page.Group.UID) } hx-get={ clearPoliticalGroupVotesURL(page.Group.UID) } hx-target="#groupe-votes-panel" hx-swap="outerHTML" hx-push-url="true">Effacer</a>
			}
		</div>
	</form>
}

templ PoliticalGroupStatsTable(stats []PoliticalGroupVoteStat) {
	<div class="table-scroll political-group-stats-table">
		<table class="data-table">
			<thead>
				<tr>
					<th scope="col">Législature</th>
					<th scope="col">Scrutins</th>
					<th scope="col">Pour</th>
					<th scope="col">Contre</th>
					<th scope="col">Abstentions</th>
					<th scope="col">Non votants</th>
				</tr>
			</thead>
			<tbody>
				for _, stat := range stats {
					<tr>
						<th scope="row">{ strconv.Itoa(stat.Legislature) }</th>
						<td>{ strconv.Itoa(stat.TotalScrutins) }</td>
						<td>{ strconv.Itoa(stat.Pour) }</td>
						<td>{ strconv.Itoa(stat.Contre) }</td>
						<td>{ strconv.Itoa(stat.Abstentions) }</td>
						<td>{ strconv.Itoa(stat.NonVotants) }</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ PoliticalGroupVotesTable(votes []PoliticalGroupVote) {
	<div class="table-scroll">
		<table class="data-table political-group-votes-table">
			<thead>
				<tr>
					<th scope="col">Date</th>
					<th scope="col">Scrutin</th>
					<th scope="col">Position</th>
					<th scope="col">Pour</th>
					<th scope="col">Contre</th>
					<th scope="col">Résultat</th>
				</tr>
			</thead>
			<tbody>
				for _, vote := range votes {
					<tr>
						<td>{ formatDate(vote.Date) }</td>
						<th scope="row">
							<a href={ ScrutinDetailURL(vote.ScrutinUID) }>Scrutin n°{ strconv.Itoa(vote.Numero) }</a>
							<span class="deputy-votes-table__title">{ capitalizeFirstLetter(vote.Titre) }</span>
						</th>
						<td><span class={ individualVotePositionClass(vote.PositionMajoritaire) }>{ individualVotePositionLabel(vote.PositionMajoritaire) }</span></td>
						<td>{ strconv.Itoa(vote.Pour) }</td>
						<td>{ strconv.Itoa(vote.Contre) }</td>
						<td><span class={ resultChipClass(vote.SortCode) }>{ politicalGroupVoteResultLabel(vote) }</span></td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ PoliticalGroupVotesPagination(page PoliticalGroupDetailPage) {
	<nav class="pagination" aria-label="Pagination de l'historique des votes du groupe">
		if page.Query.VotesPage > 1 {
			<a class="pagination__link" href={ politicalGroupVotesPageURL(page, page.Query.VotesPage - 1) } hx-get={ politicalGroupVotesPageURL(page, page.Query.VotesPage - 1) } hx-target="#groupe-votes-panel" hx-swap="outerHTML" hx-push-url="true">Précédent</a>
		} else {
			<span class="pagination__link pagination__link--disabled">Précédent</span>
		}

		<div class="pagination__pages">
			for _, pageNumber := range paginationPages(page.Query.VotesPage, page.VotesTotalPages) {
				if pageNumber == 0 {
					<span class="pagination__ellipsis" aria-hidden="true">...</span>
				} else if pageNumber == page.Query.VotesPage {
					<span class="pagination__link pagination__link--current" aria-current="page">{ strconv.Itoa(pageNumber) }</span>
				} else {
					<a class="pagination__link" href={ politicalGroupVotesPageURL(page, pageNumber) } hx-get={ politicalGroupVotesPageURL(page, pageNumber) } hx-target="#groupe-votes-panel" hx-swap="outerHTML" hx-push-url="true">{ strconv.Itoa(pageNumber) }</a>
				}
			}
		</div>

		if page.Query.VotesPage < page.VotesTotalPages {
			<a class="pagination__link" href={ politicalGroupVotesPageURL(page, page.Query.VotesPage + 1) } hx-get={ politicalGroupVotesPageURL(page, page.Query.VotesPage + 1) } hx-target="#groupe-votes-panel" hx-swap="outerHTML" hx-push-url="true">Suivant</a>
		} else {
			<span class="pagination__link pagination__link--disabled">Suivant</span>
		}
	</nav>
}

func PoliticalGroupDetailURL(uid string) string {
	return "/groupes/" + url.PathEscape(uid)
}

func PoliticalGroupLabel(group PoliticalGroupData) string {
	return fallbackText(firstNonEmpty(group.Libelle, group.LibelleEdition, group.LibelleAbrege, group.LibelleAbrev, group.UID))
}

func politicalGroupLogoURL(group PoliticalGroupData) string {
	return groupLogoURL(DeputyMandatOrgane{
		UID:           group.UID,
		CodeType:      group.CodeType,
		Libelle:       group.Libelle,
		LibelleAbrege: group.LibelleAbrege,
		LibelleAbrev:  group.LibelleAbrev,
	})
}

func politicalGroupTotalScrutins(page PoliticalGroupDetailPage) int {
	total := 0
	for _, stat := range page.Stats {
		total += stat.TotalScrutins
	}
	if total == 0 {
		return page.VotesTotalResults
	}
	return total
}

func politicalGroupTotalPour(stats []PoliticalGroupVoteStat) int {
	total := 0
	for _, stat := range stats {
		total += stat.Pour
	}
	return total
}

func politicalGroupTotalContre(stats []PoliticalGroupVoteStat) int {
	total := 0
	for _, stat := range stats {
		total += stat.Contre
	}
	return total
}

func politicalGroupVotesSummary(page PoliticalGroupDetailPage) string {
	if page.VotesTotalResults == 0 {
		return "0 vote de groupe trouvé."
	}
	return strconv.Itoa(page.VotesStartItem) + "-" + strconv.Itoa(page.VotesEndItem) + " sur " + strconv.Itoa(page.VotesTotalResults) + " votes de groupe."
}

func politicalGroupVotesPageURL(page PoliticalGroupDetailPage, pageNumber int) string {
	values := url.Values{}
	if strings.TrimSpace(page.Query.VotesSearch) != "" {
		values.Set("votes_q", page.Query.VotesSearch)
	}
	if page.Query.VotesPosition != "" {
		values.Set("votes_position", page.Query.VotesPosition)
	}
	if page.Query.VotesSort != "" && page.Query.VotesSort != defaultPoliticalGroupVotesSort {
		values.Set("votes_sort", page.Query.VotesSort)
	}
	if pageNumber > 1 {
		values.Set("votes_page", strconv.Itoa(pageNumber))
	}
	encoded := values.Encode()
	if encoded == "" {
		return PoliticalGroupDetailURL(page.Group.UID) + "#groupe-votes"
	}
	return PoliticalGroupDetailURL(page.Group.UID) + "?" + encoded + "#groupe-votes"
}

func clearPoliticalGroupVotesURL(uid string) string {
	return PoliticalGroupDetailURL(uid) + "#groupe-votes"
}

func politicalGroupVotesSortSummary(query PoliticalGroupDetailQuery) string {
	for _, option := range politicalGroupVoteSortOptions() {
		if option.Value == query.VotesSort {
			return "Tri actuel : " + strings.ToLower(option.Label) + "."
		}
	}
	return "Tri actuel : date récente."
}

func hasPoliticalGroupVoteControls(query PoliticalGroupDetailQuery) bool {
	return strings.TrimSpace(query.VotesSearch) != "" ||
		query.VotesPosition != "" ||
		(query.VotesSort != "" && query.VotesSort != defaultPoliticalGroupVotesSort)
}

func politicalGroupVoteSortOptions() []DeputyVoteOption {
	return []DeputyVoteOption{
		{Value: "date_desc", Label: "Date récente"},
		{Value: "date_asc", Label: "Date ancienne"},
	}
}

func politicalGroupVotePositionOptions() []DeputyVoteOption {
	return []DeputyVoteOption{
		{Value: "pour", Label: "Pour"},
		{Value: "contre", Label: "Contre"},
		{Value: "abstention", Label: "Abstention"},
		{Value: "non_votant", Label: "Non votant"},
		{Value: "non_votant_volontaire", Label: "Non votant volontaire"},
	}
}

func politicalGroupDeputyMeta(deputy PoliticalGroupDeputy) string {
	parts := make([]string, 0, 3)
	if deputy.Alpha != "" {
		parts = append(parts, deputy.Alpha)
	}
	if deputy.Legislature > 0 {
		parts = append(parts, strconv.Itoa(deputy.Legislature)+"e législature")
	}
	return fallbackText(strings.Join(parts, " · "))
}

func visiblePoliticalGroupDeputies(deputies []PoliticalGroupDeputy) []PoliticalGroupDeputy {
	if len(deputies) <= visiblePoliticalGroupDeputiesCount {
		return deputies
	}
	return deputies[:visiblePoliticalGroupDeputiesCount]
}

func hiddenPoliticalGroupDeputies(deputies []PoliticalGroupDeputy) []PoliticalGroupDeputy {
	if len(deputies) <= visiblePoliticalGroupDeputiesCount {
		return nil
	}
	return deputies[visiblePoliticalGroupDeputiesCount:]
}

func politicalGroupRemainingDeputiesLabel(count int) string {
	if count == 1 {
		return "Voir 1 autre député"
	}
	return "Voir " + strconv.Itoa(count) + " autres députés"
}

func politicalGroupDeputyPhotoURL(deputy PoliticalGroupDeputy) string {
	photoID := deputyPhotoID(deputy.UID)
	if photoID == "" {
		return ""
	}
	legislature := deputy.Legislature
	if legislature <= 0 {
		legislature = 17
	}
	return "https://www.assemblee-nationale.fr/dyn/static/tribun/" + strconv.Itoa(legislature) + "/photos/carre/" + photoID + ".jpg"
}

func politicalGroupDeputyInitials(deputy PoliticalGroupDeputy) string {
	name := strings.Fields(firstNonEmpty(deputy.DisplayName, deputy.Alpha, deputy.UID))
	if len(name) == 0 {
		return "?"
	}
	if len(name) == 1 {
		return strings.ToUpper(string([]rune(name[0])[0]))
	}
	first := []rune(name[0])
	last := []rune(name[len(name)-1])
	return strings.ToUpper(string(first[0]) + string(last[0]))
}

func politicalGroupVoteResultLabel(vote PoliticalGroupVote) string {
	return deputyVoteResultLabel(DeputyVote{SortCode: vote.SortCode, SortLibelle: vote.SortLibelle})
}
