package components

import (
	"net/url"
	"strconv"
	"strings"
)

type PoliticalGroupsQuery struct {
	Search      string
	Sort        string
	Page        int
	PerPage     int
	Legislature int
}

type PoliticalGroupListItem struct {
	UID           string
	Libelle       string
	LibelleAbrege string
	LibelleAbrev  string
	Legislature   int
	Position      string
	Preseance     int
	DateDebut     string
	DateFin       string
	DeputiesCount int
	TotalScrutins int
	Pour          int
	Contre        int
	Abstentions   int
	NonVotants    int
}

type PoliticalGroupSortOption struct {
	Value string
	Label string
}

type PoliticalGroupFilterOption struct {
	Value string
	Label string
}

type PoliticalGroupFilterOptions struct {
	Legislatures []PoliticalGroupFilterOption
}

type PoliticalGroupsPage struct {
	Query         PoliticalGroupsQuery
	DefaultSort   string
	SortOptions   []PoliticalGroupSortOption
	FilterOptions PoliticalGroupFilterOptions
	Groups        []PoliticalGroupListItem
	TotalResults  int
	TotalPages    int
	StartItem     int
	EndItem       int
}

templ PoliticalGroups(page PoliticalGroupsPage) {
	<div class="page-shell">
		@SiteHeader("groupes")

		<main id="contenu" class="page-main">
			<section class="section page-heading">
				<div class="fr-container">
					<p class="eyebrow">Exploration</p>
					<h1>Forces politiques</h1>
					<p class="lead">
						Recherchez un groupe politique, filtrez par législature, puis consultez sa fiche détaillée, ses députés rattachés et son historique de votes.
					</p>
				</div>
			</section>

			<section class="section section--muted">
				<div class="fr-container">
					@PoliticalGroupsExplorer(page)
				</div>
			</section>
		</main>

		@SiteFooter()
	</div>
}

templ PoliticalGroupsExplorer(page PoliticalGroupsPage) {
	<div id="political-groups-explorer">
		<form class="scrutin-toolbar political-groups-toolbar" method="get" action="/groupes" role="search" hx-get="/groupes" hx-target="#political-groups-explorer" hx-swap="outerHTML" hx-push-url="true">
			<label class="field field--search" for="q">
				<span>Recherche</span>
				<input id="q" name="q" type="search" value={ page.Query.Search } placeholder="Ex. Renaissance, gauche, groupe"/>
			</label>
			<div class="scrutin-filters political-groups-filters" aria-label="Filtres des forces politiques">
				<label class="field" for="legislature">
					<span>Législature</span>
					<select id="legislature" name="legislature">
						<option value="">Toutes</option>
						for _, option := range page.FilterOptions.Legislatures {
							<option value={ option.Value } selected?={ option.Value == strconv.Itoa(page.Query.Legislature) }>{ option.Label }</option>
						}
					</select>
				</label>
			</div>
			<input type="hidden" name="sort" value={ page.Query.Sort }/>
			<div class="scrutin-toolbar__actions">
				<button class="button" type="submit">Appliquer</button>
				if hasPoliticalGroupFilters(page.Query) {
					<a class="button button--secondary" href={ clearPoliticalGroupSearchURL(page.Query, page.DefaultSort) } hx-get={ clearPoliticalGroupSearchURL(page.Query, page.DefaultSort) } hx-target="#political-groups-explorer" hx-swap="outerHTML" hx-push-url="true">Effacer</a>
				}
			</div>
		</form>

		<div class="sort-panel" aria-label="Options de tri">
			<span>Trier par</span>
			<div class="sort-panel__links">
				for _, option := range page.SortOptions {
					<a class={ sortLinkClass(option.Value == page.Query.Sort) } href={ politicalGroupListURL(page.Query, page.DefaultSort, 1, option.Value) } hx-get={ politicalGroupListURL(page.Query, page.DefaultSort, 1, option.Value) } hx-target="#political-groups-explorer" hx-swap="outerHTML" hx-push-url="true">{ option.Label }</a>
				}
			</div>
		</div>

		<div class="list-status" aria-live="polite">
			<p>{ politicalGroupResultSummary(page) }</p>
			<p>Tri actuel : { currentPoliticalGroupSortLabel(page) }.</p>
		</div>

		if len(page.Groups) == 0 {
			<p class="empty-state">Aucune force politique ne correspond aux critères. Modifiez la recherche ou relancez <code>make preprocess</code> si la base est vide.</p>
		} else {
			<div class="political-group-list" aria-label="Liste paginée des forces politiques">
				for _, group := range page.Groups {
					@PoliticalGroupCard(group)
				}
			</div>

			@PoliticalGroupsPagination(page)
		}
	</div>
}

templ PoliticalGroupCard(group PoliticalGroupListItem) {
	<article class="political-group-card">
		<div class="political-group-card__logo-wrap">
			if politicalGroupListLogoURL(group) != "" {
				<img class="political-group-card__logo" src={ politicalGroupListLogoURL(group) } alt={ "Logo du groupe " + politicalGroupListLabel(group) } loading="lazy" width="96" height="96"/>
			} else {
				<span class="political-group-card__logo political-group-card__logo--placeholder" aria-hidden="true">{ politicalGroupListInitials(group) }</span>
			}
		</div>
		<div class="political-group-card__body">
			<p class="eyebrow">Groupe politique</p>
			<h2><a class="scrutin-card__title-link" href={ PoliticalGroupDetailURL(group.UID) }>{ politicalGroupListLabel(group) }</a></h2>
			<div class="deputy-card__meta">
				if group.LibelleAbrev != "" {
					<span>{ group.LibelleAbrev }</span>
				}
				if group.Legislature > 0 {
					<span>{ strconv.Itoa(group.Legislature) }e législature</span>
				}
				if group.Position != "" {
					<span>{ group.Position }</span>
				}
			</div>
			<p>{ politicalGroupListPeriod(group) }</p>
		</div>
		<dl class="political-group-card__stats" aria-label="Synthèse du groupe">
			<div>
				<dt>Députés</dt>
				<dd>{ strconv.Itoa(group.DeputiesCount) }</dd>
			</div>
			<div>
				<dt>Scrutins</dt>
				<dd>{ strconv.Itoa(group.TotalScrutins) }</dd>
			</div>
			<div class="vote-count--pour">
				<dt>Pour</dt>
				<dd>{ strconv.Itoa(group.Pour) }</dd>
			</div>
			<div class="vote-count--contre">
				<dt>Contre</dt>
				<dd>{ strconv.Itoa(group.Contre) }</dd>
			</div>
		</dl>
	</article>
}

templ PoliticalGroupsPagination(page PoliticalGroupsPage) {
	<nav class="pagination" aria-label="Pagination des forces politiques">
		if page.Query.Page > 1 {
			<a class="pagination__link" href={ politicalGroupListURL(page.Query, page.DefaultSort, page.Query.Page - 1, page.Query.Sort) } hx-get={ politicalGroupListURL(page.Query, page.DefaultSort, page.Query.Page - 1, page.Query.Sort) } hx-target="#political-groups-explorer" hx-swap="outerHTML" hx-push-url="true">Précédent</a>
		} else {
			<span class="pagination__link pagination__link--disabled">Précédent</span>
		}

		<div class="pagination__pages">
			for _, pageNumber := range paginationPages(page.Query.Page, page.TotalPages) {
				if pageNumber == 0 {
					<span class="pagination__ellipsis" aria-hidden="true">...</span>
				} else if pageNumber == page.Query.Page {
					<span class="pagination__link pagination__link--current" aria-current="page">{ strconv.Itoa(pageNumber) }</span>
				} else {
					<a class="pagination__link" href={ politicalGroupListURL(page.Query, page.DefaultSort, pageNumber, page.Query.Sort) } hx-get={ politicalGroupListURL(page.Query, page.DefaultSort, pageNumber, page.Query.Sort) } hx-target="#political-groups-explorer" hx-swap="outerHTML" hx-push-url="true">{ strconv.Itoa(pageNumber) }</a>
				}
			}
		</div>

		if page.Query.Page < page.TotalPages {
			<a class="pagination__link" href={ politicalGroupListURL(page.Query, page.DefaultSort, page.Query.Page + 1, page.Query.Sort) } hx-get={ politicalGroupListURL(page.Query, page.DefaultSort, page.Query.Page + 1, page.Query.Sort) } hx-target="#political-groups-explorer" hx-swap="outerHTML" hx-push-url="true">Suivant</a>
		} else {
			<span class="pagination__link pagination__link--disabled">Suivant</span>
		}
	</nav>
}

func politicalGroupListURL(query PoliticalGroupsQuery, defaultSort string, page int, sort string) string {
	values := url.Values{}
	if strings.TrimSpace(query.Search) != "" {
		values.Set("q", query.Search)
	}
	if query.Legislature > 0 {
		values.Set("legislature", strconv.Itoa(query.Legislature))
	}
	if sort != "" && sort != defaultSort {
		values.Set("sort", sort)
	}
	if page > 1 {
		values.Set("page", strconv.Itoa(page))
	}
	encoded := values.Encode()
	if encoded == "" {
		return "/groupes"
	}
	return "/groupes?" + encoded
}

func clearPoliticalGroupSearchURL(query PoliticalGroupsQuery, defaultSort string) string {
	query.Search = ""
	query.Legislature = 0
	return politicalGroupListURL(query, defaultSort, 1, query.Sort)
}

func hasPoliticalGroupFilters(query PoliticalGroupsQuery) bool {
	return strings.TrimSpace(query.Search) != "" || query.Legislature > 0
}

func politicalGroupResultSummary(page PoliticalGroupsPage) string {
	if page.TotalResults == 0 {
		return "0 force politique trouvée."
	}
	return strconv.Itoa(page.StartItem) + "-" + strconv.Itoa(page.EndItem) + " sur " + strconv.Itoa(page.TotalResults) + " forces politiques."
}

func currentPoliticalGroupSortLabel(page PoliticalGroupsPage) string {
	for _, option := range page.SortOptions {
		if option.Value == page.Query.Sort {
			return option.Label
		}
	}
	return page.Query.Sort
}

func politicalGroupListLabel(group PoliticalGroupListItem) string {
	return fallbackText(firstNonEmpty(group.Libelle, group.LibelleAbrege, group.LibelleAbrev, group.UID))
}

func politicalGroupListLogoURL(group PoliticalGroupListItem) string {
	return politicalGroupLogoURL(PoliticalGroupData{
		UID:           group.UID,
		CodeType:      "GP",
		Libelle:       group.Libelle,
		LibelleAbrege: group.LibelleAbrege,
		LibelleAbrev:  group.LibelleAbrev,
	})
}

func politicalGroupListInitials(group PoliticalGroupListItem) string {
	label := firstNonEmpty(group.LibelleAbrev, group.LibelleAbrege, group.Libelle, group.UID)
	if label == "" {
		return "?"
	}
	parts := strings.Fields(label)
	if len(parts) == 1 {
		runes := []rune(parts[0])
		if len(runes) <= 4 {
			return strings.ToUpper(string(runes))
		}
		return strings.ToUpper(string(runes[:2]))
	}
	initials := ""
	for _, part := range parts {
		runes := []rune(part)
		if len(runes) > 0 {
			initials += string(runes[0])
		}
		if len([]rune(initials)) == 3 {
			break
		}
	}
	return strings.ToUpper(initials)
}

func politicalGroupListPeriod(group PoliticalGroupListItem) string {
	start := formatDate(group.DateDebut)
	end := formatDate(group.DateFin)
	if start == "" && end == "" {
		return "Dates non renseignées"
	}
	if end == "" {
		return "Depuis le " + start
	}
	if start == "" {
		return "Jusqu’au " + end
	}
	return "Du " + start + " au " + end
}
