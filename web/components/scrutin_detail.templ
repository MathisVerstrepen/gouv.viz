package components

import (
	"sort"
	"strconv"
	"strings"
)

const totalDeputies = 577

type ScrutinDetailPage struct {
	Scrutin    ScrutinDetailData
	GroupVotes []ScrutinGroupVote
}

type ScrutinDetailData struct {
	UID                      string
	Numero                   int
	Legislature              int
	OrganeUID                string
	Organe                   string
	SessionRef               string
	SeanceRef                string
	Date                     string
	QuantiemeJourSeance      int
	CodeTypeVote             string
	TypeVote                 string
	TypeMajorite             string
	SortCode                 string
	SortLibelle              string
	Titre                    string
	Demandeur                string
	Objet                    string
	ModePublicationVotes     string
	NombreVotants            int
	SuffragesExprimes        int
	SuffragesRequis          int
	NonVotants               int
	Pour                     int
	Contre                   int
	Abstentions              int
	NonVotantsVolontaires    int
	SourceFile               string
}

type ScrutinGroupVote struct {
	GroupeUID                string
	Groupe                   string
	NombreMembres            int
	PositionMajoritaire      string
	NonVotants               int
	Pour                     int
	Contre                   int
	Abstentions              int
	NonVotantsVolontaires    int
}

templ ScrutinDetail(page ScrutinDetailPage) {
	<div class="page-shell">
		@SiteHeader("scrutins")

		<main id="contenu" class="page-main">
			<section class="section page-heading detail-heading">
				<div class="fr-container">
					<nav class="breadcrumb" aria-label="Fil d'Ariane">
						<a href="/">Accueil</a>
						<span aria-hidden="true">/</span>
						<a href="/scrutins">Scrutins</a>
						<span aria-hidden="true">/</span>
						<span>n{ strconv.Itoa(page.Scrutin.Numero) }</span>
					</nav>
					<div class="detail-heading__title-row">
						<h1>Scrutin n{ strconv.Itoa(page.Scrutin.Numero) }</h1>
						if officialScrutinURL(page.Scrutin) != "" {
							<div class="detail-heading__actions">
								<a class="button button--secondary" href={ officialScrutinURL(page.Scrutin) } target="_blank" rel="noopener noreferrer">
									Lire le scrutin complet
									<span class="fr-sr-only"> sur le site de l'Assemblee nationale (nouvelle fenetre)</span>
								</a>
							</div>
						}
					</div>
					<p class="lead">{ page.Scrutin.Titre }</p>
					<div class="detail-heading__meta">
						<span>{ formatDate(page.Scrutin.Date) }</span>
						if page.Scrutin.Organe != "" {
							<span>{ page.Scrutin.Organe }</span>
						}
						if page.Scrutin.TypeVote != "" {
							<span>{ page.Scrutin.TypeVote }</span>
						}
						if page.Scrutin.SortCode != "" {
							<span class="result-chip">{ page.Scrutin.SortCode }</span>
						}
					</div>
				</div>
			</section>

			<section class="section section--muted">
				<div class="fr-container detail-layout">
					<div class="detail-main">
						<section class="detail-card" aria-labelledby="scrutin-resultat">
							<h2 id="scrutin-resultat">Resultat du vote</h2>
							<dl class="detail-metrics">
								<div class="detail-metric--pour">
									<dt>Pour</dt>
									<dd>{ strconv.Itoa(page.Scrutin.Pour) }</dd>
								</div>
								<div class="detail-metric--contre">
									<dt>Contre</dt>
									<dd>{ strconv.Itoa(page.Scrutin.Contre) }</dd>
								</div>
								<div class="detail-metric--abstention">
									<dt>Abstentions</dt>
									<dd>{ strconv.Itoa(page.Scrutin.Abstentions) }</dd>
								</div>
								<div>
									<dt>Votants</dt>
									<dd>{ strconv.Itoa(page.Scrutin.NombreVotants) }</dd>
								</div>
								<div>
									<dt>Suffrages exprimes</dt>
									<dd>{ strconv.Itoa(page.Scrutin.SuffragesExprimes) }</dd>
								</div>
								<div>
									<dt>Majorite requise</dt>
									<dd>{ strconv.Itoa(page.Scrutin.SuffragesRequis) }</dd>
								</div>
							</dl>

							<div class="vote-breakdowns" aria-label="Representation graphique des votes">
								@VoteBreakdownBar("Votes exprimes par les votants", "Base : " + strconv.Itoa(votersTotal(page.Scrutin)) + " votants", []VoteSegment{
									{Label: "Pour", Count: page.Scrutin.Pour, Class: "vote-segment--pour"},
									{Label: "Abstentions", Count: page.Scrutin.Abstentions, Class: "vote-segment--abstention"},
									{Label: "Contre", Count: page.Scrutin.Contre, Class: "vote-segment--contre"},
								}, votersTotal(page.Scrutin))
								@VoteBreakdownBar("Participation dans l'hemicycle", "Base : 577 deputes", []VoteSegment{
									{Label: "Pour", Count: page.Scrutin.Pour, Class: "vote-segment--pour"},
									{Label: "Abstentions", Count: page.Scrutin.Abstentions, Class: "vote-segment--abstention"},
									{Label: "Contre", Count: page.Scrutin.Contre, Class: "vote-segment--contre"},
									{Label: "Non votants", Count: nonVotingDeputies(page.Scrutin), Class: "vote-segment--non-votant"},
								}, totalDeputies)
							</div>
						</section>

						<section class="detail-card" aria-labelledby="scrutin-objet">
							<h2 id="scrutin-objet">Objet et demande</h2>
							if page.Scrutin.Objet != "" {
								<p>{ page.Scrutin.Objet }</p>
							} else {
								<p class="fr-text--mention">Objet non renseigne.</p>
							}
							<dl class="detail-list">
								@DetailRow("Demandeur", page.Scrutin.Demandeur)
								@DetailRow("Mode de publication", page.Scrutin.ModePublicationVotes)
								@DetailRow("Type de majorite", page.Scrutin.TypeMajorite)
								@DetailRow("Libelle du sort", page.Scrutin.SortLibelle)
							</dl>
						</section>

						<section class="detail-card" aria-labelledby="scrutin-groupes">
							<h2 id="scrutin-groupes">Votes par groupe</h2>
							if len(page.GroupVotes) == 0 {
								<p class="empty-state">Aucun detail par groupe disponible pour ce scrutin.</p>
							} else {
								@GroupVoteStackedChart(page.GroupVotes)
								<details class="group-vote-details">
									<summary>Voir les donnees detaillees par groupe</summary>
									@GroupVoteTable(page.GroupVotes)
								</details>
							}
						</section>
					</div>

					<aside class="detail-aside" aria-labelledby="scrutin-informations">
						<section class="detail-card">
							<h2 id="scrutin-informations">Informations</h2>
							<dl class="detail-list">
								@DetailRow("UID", page.Scrutin.UID)
								@DetailRow("Legislature", strconv.Itoa(page.Scrutin.Legislature))
								@DetailRow("Organe", page.Scrutin.Organe)
								@DetailRow("Organe UID", page.Scrutin.OrganeUID)
								@DetailRow("Session", page.Scrutin.SessionRef)
								@DetailRow("Seance", page.Scrutin.SeanceRef)
								@DetailRow("Jour de seance", numberOrEmpty(page.Scrutin.QuantiemeJourSeance))
								@DetailRow("Code type vote", page.Scrutin.CodeTypeVote)
								@DetailRow("Source", page.Scrutin.SourceFile)
							</dl>
						</section>
					</aside>
				</div>
			</section>
		</main>

		@SiteFooter()
	</div>
}

type VoteSegment struct {
	Label string
	Count int
	Class string
}

templ VoteBreakdownBar(title string, description string, segments []VoteSegment, total int) {
	<div class="vote-breakdown">
		<div class="vote-breakdown__header">
			<h3>{ title }</h3>
			<p>{ description }</p>
		</div>
		<div class="vote-breakdown__bar" role="img" aria-label={ voteBreakdownLabel(title, segments, total) }>
			for _, cell := range voteBreakdownCells(segments, total) {
				<span class={ "vote-cell " + cell.Class } title={ cell.Label }>
					<span class="fr-sr-only">{ cell.Label }</span>
				</span>
			}
			<span class="vote-breakdown__marker vote-breakdown__marker--50" aria-hidden="true"></span>
		</div>
		<ul class="vote-breakdown__legend">
			for _, segment := range segments {
				<li>
					<span class={ "vote-breakdown__swatch " + segment.Class } aria-hidden="true"></span>
					<span>{ segment.Label }</span>
					<strong>{ strconv.Itoa(segment.Count) }</strong>
					<span>{ votePercent(segment.Count, total) }</span>
				</li>
			}
		</ul>
	</div>
}

templ GroupVoteStackedChart(groupVotes []ScrutinGroupVote) {
	<figure class="group-vote-chart">
		<figcaption>
			Chaque colonne est normalisee a 100% des votes exprimes du groupe.
		</figcaption>
		<ul class="group-vote-chart__legend" aria-label="Legende du graphique">
			<li><span class="vote-breakdown__swatch vote-segment--pour" aria-hidden="true"></span>Pour</li>
			<li><span class="vote-breakdown__swatch vote-segment--abstention" aria-hidden="true"></span>Abstentions</li>
			<li><span class="vote-breakdown__swatch vote-segment--contre" aria-hidden="true"></span>Contre</li>
		</ul>
		<div class="group-vote-chart__plot">
			<div class="group-vote-chart__y-axis" aria-hidden="true">
				<span>100%</span>
				<span>75%</span>
				<span>50%</span>
				<span>25%</span>
				<span>0%</span>
			</div>
			<div class="group-vote-chart__scroller" aria-label="Graphique des votes par groupe">
				<div class="group-vote-chart__bars">
					for _, groupVote := range sortedGroupVotesForChart(groupVotes) {
						<div class="group-vote-chart__group">
							<span class="group-vote-chart__voters" title={ groupVote.Groupe + " : " + strconv.Itoa(groupVoteTotal(groupVote)) + " votants" }>{ strconv.Itoa(groupVoteTotal(groupVote)) }</span>
							<div class="group-vote-chart__bar" role="img" aria-label={ voteBreakdownLabel(groupVote.Groupe, groupVoteSegments(groupVote), groupVoteTotal(groupVote)) }>
								for _, cell := range groupVoteChartCells(groupVote) {
									<span class={ "vote-cell " + cell.Class } title={ cell.Title } aria-hidden="true"></span>
								}
							</div>
							<span class="group-vote-chart__label" title={ groupVote.Groupe }>{ groupVote.Groupe }</span>
						</div>
					}
				</div>
			</div>
		</div>
	</figure>
}

templ GroupVoteTable(groupVotes []ScrutinGroupVote) {
	<div class="table-scroll">
		<table class="data-table">
			<thead>
				<tr>
					<th scope="col">Groupe</th>
					<th scope="col">Position declaree</th>
					<th scope="col">Membres</th>
					<th scope="col">Pour</th>
					<th scope="col">Contre</th>
					<th scope="col">Abst.</th>
					<th scope="col">Non votants</th>
				</tr>
			</thead>
			<tbody>
				for _, groupVote := range groupVotes {
					<tr>
						<th scope="row">{ groupVote.Groupe }</th>
						<td>{ fallbackText(groupVote.PositionMajoritaire) }</td>
						<td>{ strconv.Itoa(groupVote.NombreMembres) }</td>
						<td>{ strconv.Itoa(groupVote.Pour) }</td>
						<td>{ strconv.Itoa(groupVote.Contre) }</td>
						<td>{ strconv.Itoa(groupVote.Abstentions) }</td>
						<td>{ strconv.Itoa(groupVote.NonVotants) }</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

type VoteCell struct {
	Label string
	Class string
	Title string
}

templ DetailRow(label string, value string) {
	<div>
		<dt>{ label }</dt>
		<dd>{ fallbackText(value) }</dd>
	</div>
}

func fallbackText(value string) string {
	if value == "" {
		return "Non renseigne"
	}
	return value
}

func numberOrEmpty(value int) string {
	if value == 0 {
		return ""
	}
	return strconv.Itoa(value)
}

func officialScrutinURL(scrutin ScrutinDetailData) string {
	if scrutin.Legislature <= 0 || scrutin.Numero <= 0 {
		return ""
	}
	return "https://www.assemblee-nationale.fr/dyn/" + strconv.Itoa(scrutin.Legislature) + "/scrutins/" + strconv.Itoa(scrutin.Numero)
}

func votersTotal(scrutin ScrutinDetailData) int {
	if scrutin.NombreVotants > 0 {
		return scrutin.NombreVotants
	}
	return scrutin.Pour + scrutin.Contre + scrutin.Abstentions
}

func nonVotingDeputies(scrutin ScrutinDetailData) int {
	nonVoting := totalDeputies - votersTotal(scrutin)
	if nonVoting < 0 {
		return 0
	}
	return nonVoting
}

func groupVoteSegments(groupVote ScrutinGroupVote) []VoteSegment {
	return []VoteSegment{
		{Label: "Pour", Count: groupVote.Pour, Class: "vote-segment--pour"},
		{Label: "Abstentions", Count: groupVote.Abstentions, Class: "vote-segment--abstention"},
		{Label: "Contre", Count: groupVote.Contre, Class: "vote-segment--contre"},
	}
}

func groupVoteTotal(groupVote ScrutinGroupVote) int {
	return groupVote.Pour + groupVote.Contre + groupVote.Abstentions
}

func groupVoteChartCells(groupVote ScrutinGroupVote) []VoteCell {
	cells := voteBreakdownCells(groupVoteSegments(groupVote), groupVoteTotal(groupVote))
	for index, cell := range cells {
		cells[index].Title = groupVoteSegmentTitle(groupVote, cell.Label)
	}
	return cells
}

func groupVoteSegmentTitle(groupVote ScrutinGroupVote, label string) string {
	count := 0
	switch label {
	case "Pour":
		count = groupVote.Pour
	case "Abstentions":
		count = groupVote.Abstentions
	case "Contre":
		count = groupVote.Contre
	}
	return groupVote.Groupe + " - " + label + " : " + strconv.Itoa(count) + " voix (" + votePercent(count, groupVoteTotal(groupVote)) + ")"
}

func sortedGroupVotesForChart(groupVotes []ScrutinGroupVote) []ScrutinGroupVote {
	sorted := append([]ScrutinGroupVote(nil), groupVotes...)
	sort.SliceStable(sorted, func(i int, j int) bool {
		leftRank := groupPoliticalRank(sorted[i].Groupe)
		rightRank := groupPoliticalRank(sorted[j].Groupe)
		if leftRank == rightRank {
			return strings.Compare(sorted[i].Groupe, sorted[j].Groupe) < 0
		}
		return leftRank < rightRank
	})
	return sorted
}

func groupPoliticalRank(group string) int {
	ranks := map[string]int{
		"LFI-NFP": 10,
		"GDR":     20,
		"ECOS":    30,
		"SOC":     40,
		"LIOT":    50,
		"DEM":     60,
		"EPR":     70,
		"HOR":     80,
		"DR":      90,
		"NI":      100,
		"UDR":     110,
		"RN":      120,
	}
	if rank, ok := ranks[strings.ToUpper(strings.TrimSpace(group))]; ok {
		return rank
	}
	return 1000
}

func votePercent(count int, total int) string {
	if count <= 0 || total <= 0 {
		return "0%"
	}
	percent := (float64(count) / float64(total)) * 100
	return strconv.FormatFloat(percent, 'f', 1, 64) + "%"
}

func voteBreakdownLabel(title string, segments []VoteSegment, total int) string {
	label := title + ", total " + strconv.Itoa(total)
	for _, segment := range segments {
		label += ", " + segment.Label + " " + strconv.Itoa(segment.Count) + " (" + votePercent(segment.Count, total) + ")"
	}
	return label
}

func voteBreakdownCells(segments []VoteSegment, total int) []VoteCell {
	const cellCount = 100

	cells := make([]VoteCell, 0, cellCount)
	if total <= 0 {
		return cells
	}

	for index := range cellCount {
		position := (float64(index) + 0.5) * float64(total) / cellCount
		cumulative := 0
		cell := VoteCell{Label: "Non renseigne", Class: "vote-segment--non-votant"}

		for _, segment := range segments {
			if segment.Count <= 0 {
				continue
			}
			cumulative += segment.Count
			if position < float64(cumulative) {
				cell = VoteCell{Label: segment.Label, Class: segment.Class}
				break
			}
		}

		cells = append(cells, cell)
	}

	return cells
}
