package components

import (
	"net/url"
	"strconv"
	"strings"
	"unicode"
	"unicode/utf8"
)

type ScrutinsQuery struct {
	Search      string
	Sort        string
	Page        int
	PerPage     int
	Legislature int
	Result      string
	VoteType    string
	Organe      string
	DateFrom    string
	DateTo      string
	CloseVotes  bool
}

type ScrutinSortOption struct {
	Value string
	Label string
}

type ScrutinFilterOption struct {
	Value string
	Label string
}

type ScrutinFilterOptions struct {
	Legislatures []ScrutinFilterOption
	Results      []ScrutinFilterOption
	VoteTypes    []ScrutinFilterOption
	Organes      []ScrutinFilterOption
}

type ScrutinsPage struct {
	Query         ScrutinsQuery
	DefaultSort   string
	SortOptions   []ScrutinSortOption
	FilterOptions ScrutinFilterOptions
	Scrutins      []ScrutinListItem
	TotalResults  int
	TotalPages    int
	StartItem     int
	EndItem       int
}

templ Scrutins(page ScrutinsPage) {
	<div class="page-shell">
		@SiteHeader("scrutins")

		<main id="contenu" class="page-main">
			<section class="section page-heading">
				<div class="fr-container">
					<p class="eyebrow">Exploration</p>
					<h1>Tous les scrutins publics</h1>
					<p class="lead">
						Recherchez dans les titres, objets, demandeurs, résultats et organes, puis parcourez les scrutins avec tri et pagination.
					</p>
				</div>
			</section>

			<section class="section section--muted">
				<div class="fr-container">
					@ScrutinsExplorer(page)
				</div>
			</section>
		</main>

		@SiteFooter()
	</div>
}

templ ScrutinsExplorer(page ScrutinsPage) {
	<div id="scrutins-explorer">
		<form class="scrutin-toolbar" method="get" action="/scrutins" role="search" hx-get="/scrutins" hx-target="#scrutins-explorer" hx-swap="outerHTML" hx-push-url="true">
			<label class="field field--search" for="q">
				<span>Recherche</span>
				<input id="q" name="q" type="search" value={ page.Query.Search } placeholder="Ex. budget, motion, rejet, Assemblée"/>
			</label>
			<div class="scrutin-filters" aria-label="Filtres des scrutins">
				<label class="field" for="legislature">
					<span>Législature</span>
					<select id="legislature" name="legislature">
						<option value="">Toutes</option>
						for _, option := range page.FilterOptions.Legislatures {
							<option value={ option.Value } selected?={ option.Value == strconv.Itoa(page.Query.Legislature) }>{ option.Label }</option>
						}
					</select>
				</label>
				<label class="field" for="result">
					<span>Résultat</span>
					<select id="result" name="result">
						<option value="">Tous</option>
						for _, option := range page.FilterOptions.Results {
							<option value={ option.Value } selected?={ option.Value == page.Query.Result }>{ option.Label }</option>
						}
					</select>
				</label>
				<label class="field" for="vote_type">
					<span>Type de vote</span>
					<select id="vote_type" name="vote_type">
						<option value="">Tous</option>
						for _, option := range page.FilterOptions.VoteTypes {
							<option value={ option.Value } selected?={ option.Value == page.Query.VoteType }>{ option.Label }</option>
						}
					</select>
				</label>
				<label class="field" for="organe">
					<span>Organe ou groupe</span>
					<select id="organe" name="organe">
						<option value="">Tous</option>
						for _, option := range page.FilterOptions.Organes {
							<option value={ option.Value } selected?={ option.Value == page.Query.Organe }>{ option.Label }</option>
						}
					</select>
				</label>
				<label class="field" for="date_from">
					<span>Depuis le</span>
					<input id="date_from" name="date_from" type="date" value={ page.Query.DateFrom }/>
				</label>
				<label class="field" for="date_to">
					<span>Jusqu’au</span>
					<input id="date_to" name="date_to" type="date" value={ page.Query.DateTo }/>
				</label>
				<label class="field field--checkbox" for="close_votes">
					<input id="close_votes" name="close_votes" type="checkbox" value="1" checked?={ page.Query.CloseVotes }/>
					<span>Votes serrés (écart ≤ 10 voix)</span>
				</label>
			</div>
			<input type="hidden" name="sort" value={ page.Query.Sort }/>
			<div class="scrutin-toolbar__actions">
				<button class="button" type="submit">Appliquer</button>
				if hasScrutinFilters(page.Query) {
					<a class="button button--secondary" href={ clearScrutinSearchURL(page.Query, page.DefaultSort) } hx-get={ clearScrutinSearchURL(page.Query, page.DefaultSort) } hx-target="#scrutins-explorer" hx-swap="outerHTML" hx-push-url="true">Effacer</a>
				}
			</div>
		</form>

		<div class="sort-panel" aria-label="Options de tri">
			<span>Trier par</span>
			<div class="sort-panel__links">
				for _, option := range page.SortOptions {
					<a class={ sortLinkClass(option.Value == page.Query.Sort) } href={ scrutinListURL(page.Query, page.DefaultSort, 1, option.Value) } hx-get={ scrutinListURL(page.Query, page.DefaultSort, 1, option.Value) } hx-target="#scrutins-explorer" hx-swap="outerHTML" hx-push-url="true">{ option.Label }</a>
				}
			</div>
		</div>

		<div class="list-status" aria-live="polite">
			<p>{ resultSummary(page) }</p>
			<p>Tri actuel : { currentSortLabel(page) }.</p>
		</div>

		if len(page.Scrutins) == 0 {
			<p class="empty-state">Aucun scrutin ne correspond aux critères. Modifiez la recherche ou relancez <code>make preprocess</code> si la base est vide.</p>
		} else {
			<div class="scrutin-list" aria-label="Liste paginée des scrutins publics">
				for _, scrutin := range page.Scrutins {
					@ScrutinCard(scrutin)
				}
			</div>

			@Pagination(page)
		}
	</div>
}

templ ScrutinCard(scrutin ScrutinListItem) {
	<article class="scrutin-card">
		<div class="scrutin-card__meta">
			<span>Scrutin n°{ strconv.Itoa(scrutin.Numero) }</span>
			<span>{ formatDate(scrutin.Date) }</span>
			if scrutin.Organe != "" {
				<span>{ scrutin.Organe }</span>
			}
		</div>
		<div class="scrutin-card__body">
			<h2><a class="scrutin-card__title-link" href={ ScrutinDetailURL(scrutin.UID) }>{ capitalizeFirstLetter(scrutin.Titre) }</a></h2>
			<p>{ scrutin.TypeVote }</p>
		</div>
		<div class="scrutin-card__result" aria-label="Résultat du scrutin">
			<span class={ resultChipClass(scrutin.SortCode) }>{ scrutin.SortCode }</span>
			<dl class="vote-counts">
				<div class="vote-count--pour">
					<dt>Pour</dt>
					<dd>{ strconv.Itoa(scrutin.Pour) }</dd>
				</div>
				<div class="vote-count--contre">
					<dt>Contre</dt>
					<dd>{ strconv.Itoa(scrutin.Contre) }</dd>
				</div>
				<div class="vote-count--abstention">
					<dt>Abst.</dt>
					<dd>{ strconv.Itoa(scrutin.Abstentions) }</dd>
				</div>
				<div>
					<dt>Votants</dt>
					<dd>{ strconv.Itoa(scrutin.NombreVotants) }</dd>
				</div>
			</dl>
			@ScrutinVoteDistributionBar(scrutin)
		</div>
	</article>
}

templ Pagination(page ScrutinsPage) {
	<nav class="pagination" aria-label="Pagination des scrutins">
		if page.Query.Page > 1 {
			<a class="pagination__link" href={ scrutinListURL(page.Query, page.DefaultSort, page.Query.Page - 1, page.Query.Sort) } hx-get={ scrutinListURL(page.Query, page.DefaultSort, page.Query.Page - 1, page.Query.Sort) } hx-target="#scrutins-explorer" hx-swap="outerHTML" hx-push-url="true">Précédent</a>
		} else {
			<span class="pagination__link pagination__link--disabled">Précédent</span>
		}

		<div class="pagination__pages">
			for _, pageNumber := range paginationPages(page.Query.Page, page.TotalPages) {
				if pageNumber == 0 {
					<span class="pagination__ellipsis" aria-hidden="true">...</span>
				} else if pageNumber == page.Query.Page {
					<span class="pagination__link pagination__link--current" aria-current="page">{ strconv.Itoa(pageNumber) }</span>
				} else {
					<a class="pagination__link" href={ scrutinListURL(page.Query, page.DefaultSort, pageNumber, page.Query.Sort) } hx-get={ scrutinListURL(page.Query, page.DefaultSort, pageNumber, page.Query.Sort) } hx-target="#scrutins-explorer" hx-swap="outerHTML" hx-push-url="true">{ strconv.Itoa(pageNumber) }</a>
				}
			}
		</div>

		if page.Query.Page < page.TotalPages {
			<a class="pagination__link" href={ scrutinListURL(page.Query, page.DefaultSort, page.Query.Page + 1, page.Query.Sort) } hx-get={ scrutinListURL(page.Query, page.DefaultSort, page.Query.Page + 1, page.Query.Sort) } hx-target="#scrutins-explorer" hx-swap="outerHTML" hx-push-url="true">Suivant</a>
		} else {
			<span class="pagination__link pagination__link--disabled">Suivant</span>
		}
	</nav>
}

templ ScrutinVoteDistributionBar(scrutin ScrutinListItem) {
	<div class="vote-distribution-bar" role="img" aria-label={ voteBreakdownLabel("Répartition des votes", scrutinVoteSegments(scrutin), scrutinListVotersTotal(scrutin)) }>
		for _, cell := range voteBreakdownCells(scrutinVoteSegments(scrutin), scrutinListVotersTotal(scrutin)) {
			<span class={ "vote-cell " + cell.Class } title={ cell.Label }>
				<span class="fr-sr-only">{ cell.Label }</span>
			</span>
		}
	</div>
}

func scrutinListURL(query ScrutinsQuery, defaultSort string, page int, sort string) string {
	values := url.Values{}
	if strings.TrimSpace(query.Search) != "" {
		values.Set("q", query.Search)
	}
	if query.Legislature > 0 {
		values.Set("legislature", strconv.Itoa(query.Legislature))
	}
	if query.Result != "" {
		values.Set("result", query.Result)
	}
	if query.VoteType != "" {
		values.Set("vote_type", query.VoteType)
	}
	if query.Organe != "" {
		values.Set("organe", query.Organe)
	}
	if query.DateFrom != "" {
		values.Set("date_from", query.DateFrom)
	}
	if query.DateTo != "" {
		values.Set("date_to", query.DateTo)
	}
	if query.CloseVotes {
		values.Set("close_votes", "1")
	}
	if sort != "" && sort != defaultSort {
		values.Set("sort", sort)
	}
	if page > 1 {
		values.Set("page", strconv.Itoa(page))
	}
	encoded := values.Encode()
	if encoded == "" {
		return "/scrutins"
	}
	return "/scrutins?" + encoded
}

func clearScrutinSearchURL(query ScrutinsQuery, defaultSort string) string {
	query.Search = ""
	query.Legislature = 0
	query.Result = ""
	query.VoteType = ""
	query.Organe = ""
	query.DateFrom = ""
	query.DateTo = ""
	query.CloseVotes = false
	return scrutinListURL(query, defaultSort, 1, query.Sort)
}

func hasScrutinFilters(query ScrutinsQuery) bool {
	return strings.TrimSpace(query.Search) != "" ||
		query.Legislature > 0 ||
		query.Result != "" ||
		query.VoteType != "" ||
		query.Organe != "" ||
		query.DateFrom != "" ||
		query.DateTo != "" ||
		query.CloseVotes
}

func sortLinkClass(active bool) string {
	if active {
		return "sort-link sort-link--active"
	}
	return "sort-link"
}

func resultChipClass(sortCode string) string {
	normalized := strings.ToLower(strings.TrimSpace(sortCode))
	normalized = strings.ReplaceAll(normalized, "\u00e9", "e")
	normalized = strings.ReplaceAll(normalized, "\u0301", "")

	switch normalized {
	case "adopte":
		return "result-chip result-chip--adopte"
	case "rejete":
		return "result-chip result-chip--rejete"
	default:
		return "result-chip"
	}
}

func resultSummary(page ScrutinsPage) string {
	if page.TotalResults == 0 {
		return "0 scrutin trouvé."
	}
	return strconv.Itoa(page.StartItem) + "-" + strconv.Itoa(page.EndItem) + " sur " + strconv.Itoa(page.TotalResults) + " scrutins."
}

func currentSortLabel(page ScrutinsPage) string {
	for _, option := range page.SortOptions {
		if option.Value == page.Query.Sort {
			return option.Label
		}
	}
	return page.Query.Sort
}

func capitalizeFirstLetter(value string) string {
	first, size := utf8.DecodeRuneInString(value)
	if size == 0 {
		return value
	}
	return string(unicode.ToUpper(first)) + value[size:]
}

func scrutinVoteSegments(scrutin ScrutinListItem) []VoteSegment {
	return []VoteSegment{
		{Label: "Pour", Count: scrutin.Pour, Class: "vote-segment--pour"},
		{Label: "Abstentions", Count: scrutin.Abstentions, Class: "vote-segment--abstention"},
		{Label: "Contre", Count: scrutin.Contre, Class: "vote-segment--contre"},
	}
}

func scrutinListVotersTotal(scrutin ScrutinListItem) int {
	if scrutin.NombreVotants > 0 {
		return scrutin.NombreVotants
	}
	return scrutin.Pour + scrutin.Contre + scrutin.Abstentions
}

func paginationPages(current int, total int) []int {
	if total <= 1 {
		return []int{1}
	}
	if total <= 7 {
		pages := make([]int, 0, total)
		for page := 1; page <= total; page++ {
			pages = append(pages, page)
		}
		return pages
	}

	start := current - 2
	if start < 2 {
		start = 2
	}
	end := current + 2
	if end > total-1 {
		end = total - 1
	}

	pages := []int{1}
	if start > 2 {
		pages = append(pages, 0)
	}
	for page := start; page <= end; page++ {
		pages = append(pages, page)
	}
	if end < total-1 {
		pages = append(pages, 0)
	}
	pages = append(pages, total)
	return pages
}
